# Copy this file to .env.local and fill in your real values, then run:
#   npm install
#   npm run local
#
# .env.local is loaded automatically by local-server.js and is already
# excluded from git via .gitignore — never commit your real .env.local.
# See "Running everything locally, without Vercel" in PLATFORM_SETUP.md.

# ---- Supabase — same values you already used for Vercel's env vars ----
# (Dashboard → Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ---- AI provider for THIS local server ----
# 'local' talks to a model running on this same PC (Ollama by default, or
# any other OpenAI-compatible local server — LM Studio, llama.cpp --api,
# vLLM). Install Ollama (https://ollama.com), run e.g.
# `ollama pull llama3.1:8b`, then set LOCAL_LLM_MODEL to match.
LLM_PROVIDER=local
LOCAL_LLM_MODEL=llama3.1:8b
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_API_KEY=            # only needed if your local server requires one

# ---- Local HTTP port for local-server.js (optional) ----
PORT=5050

# ---- Only fill these in if you set LLM_PROVIDER to a cloud provider above ----
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=
# GROQ_API_KEY=
# GROQ_MODEL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# BEDROCK_MODEL_ID=
