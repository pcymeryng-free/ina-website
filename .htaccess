# ============================================================================
# INA Platform / INA Website — Bluehost (Apache) config
#
# Mirrors the "redirects" array in vercel.json (used on Vercel, the dev/test
# environment) so old bookmarked/indexed URLs keep working on the production
# domain too. Also disables directory listing.
#
# NOTE: an earlier version of this file added a blanket
# "Cache-Control: no-cache" header for every .html response, to stop
# Bluehost from serving stale cached copies of app/*.html after an upload.
# Removed again — it turned out to also strip caching from 301 redirect
# responses themselves, which unmasked (and made every single request
# retrigger) a pre-existing self-redirect issue on the www subdomain
# (https://www.international-network-advisors.com/app/login.html kept
# 301-ing to itself), previously hidden by normal browser redirect
# caching. Signing in reliably matters more than avoiding an occasional
# manual cache-bypass (?x=1 trick) when testing right after an upload.
# ============================================================================

# ----------------------------------------------------------------------------
# Security headers
#
# script-src-attr 'none' is the important one: it blocks inline event-handler
# attributes (onerror=, onload=, onclick=...) from executing even if they get
# injected into the DOM via innerHTML somewhere we missed escaping (see the
# escapeHtml() fixes in app/master-data.html and app/activity-log.html,
# 2026-09-23). 'unsafe-inline'/'unsafe-eval' stay on script-src/style-src
# because every page on this site uses plain inline <script>/style
# attributes with no nonce system — removing those would break the site,
# not just the exploit path.
# ----------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://lyyuxoltyyckfppfjbyn.supabase.co https://api.international-network-advisors.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
</IfModule>

RewriteEngine On

RewriteRule ^login\.html$ /app/login.html [R=301,L]
RewriteRule ^register\.html$ /app/register.html [R=301,L]
RewriteRule ^dashboard\.html$ /app/dashboard.html [R=301,L]
RewriteRule ^new-project\.html$ /app/new-project.html [R=301,L]
RewriteRule ^project\.html$ /app/project.html [R=301,L]
RewriteRule ^app/security\.html$ /app/profile.html [R=301,L]
RewriteRule ^app/gestion-templates\.html$ /app/roadmap-templates.html [R=301,L]
RewriteRule ^app/new-gestion-template\.html$ /app/new-roadmap-template.html [R=301,L]
RewriteRule ^app/gestion-instance\.html$ /app/roadmap-instance.html [R=301,L]
RewriteRule ^app/?$ /app/index.html [R=302,L]

Options -Indexes

# PWA manifest — Apache has no default MIME mapping for .webmanifest,
# which some browsers are strict about when deciding whether to honor
# "Add to Home Screen" (see manifest.webmanifest at the site root).
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
