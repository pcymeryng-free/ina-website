# Template for ~/.cloudflared/config.yml — the routing config for the
# permanent Cloudflare Tunnel that lets api.international-network-advisors.com
# reach local-server.js running on your Mac, replacing Vercel for the AI
# endpoints. See "Making production use your local model (replacing Vercel)"
# in PLATFORM_SETUP.md for the full walkthrough this belongs to.
#
# HOW TO USE:
#   1. Run `cloudflared tunnel create ina-local-api` first — it prints a
#      tunnel UUID and writes ~/.cloudflared/<UUID>.json (credentials).
#   2. Copy this file to ~/.cloudflared/config.yml
#   3. Replace <TUNNEL-UUID> below (both places) with the UUID from step 1,
#      and <YOUR-MAC-USERNAME> with your macOS username (`whoami`).
#   4. Point the api DNS record at <TUNNEL-UUID>.cfargotunnel.com (see
#      PLATFORM_SETUP.md) — no changes needed here for that part.
#   5. Run `cloudflared tunnel run ina-local-api` (or install it as a
#      background service — see the com.ina.cloudflared-tunnel.plist.example
#      file in this same folder).

tunnel: <TUNNEL-UUID>
credentials-file: /Users/<YOUR-MAC-USERNAME>/.cloudflared/<TUNNEL-UUID>.json

# Only the api subdomain is routed through the tunnel — the rest of the
# site (international-network-advisors.com itself) stays on Bluehost,
# completely unrelated to this. local-server.js listens on PORT from your
# .env.local (5050 by default — change both places below if you changed it).
ingress:
  - hostname: api.international-network-advisors.com
    service: http://localhost:5050
  - service: http_status:404
